# Homebrew formula for Ferrule. Generated by `make brew VERSION=vX.Y.Z` in
# github.com/NakliTechie/ferrule from that release's SHA256SUMS — edit the template in
# packaging/brew/, not this file.
#
# Installs the prebuilt binary from the GitHub release: no Go toolchain, and because
# Homebrew fetches with curl the binary is never quarantined, so there is no Gatekeeper
# step. The Ferrule.app bundle is the cask of the same name.
class Ferrule < Formula
  desc "Every LLM key held once, encrypted, on your machine, behind one endpoint"
  homepage "https://github.com/NakliTechie/ferrule"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "https://github.com/NakliTechie/ferrule/releases/download/v__VERSION__/ferrule-darwin-arm64"
      sha256 "__SHA_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/NakliTechie/ferrule/releases/download/v__VERSION__/ferrule-darwin-amd64"
      sha256 "__SHA_DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/NakliTechie/ferrule/releases/download/v__VERSION__/ferrule-linux-arm64"
      sha256 "__SHA_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/NakliTechie/ferrule/releases/download/v__VERSION__/ferrule-linux-amd64"
      sha256 "__SHA_LINUX_AMD64__"
    end
  end

  def install
    bin.install Dir["ferrule-*"].first => "ferrule"
  end

  def caveats
    <<~EOS
      Start the daemon with `ferrule serve`; the panel is at http://localhost:8899.
      Keys live encrypted in ~/.config/ferrule and outlive this formula on uninstall.
    EOS
  end

  test do
    assert_match "ferrule v#{version}", shell_output("#{bin}/ferrule --version")
  end
end
